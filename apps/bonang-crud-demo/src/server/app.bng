// Pabrik aplikasi Bonang CRUD Demo.
//
// Dipisah dari `main.bng` supaya entry point server dan test integrasi
// memakai jalur setup yang identik — tidak ada logika yang diduplikasi.

import { createServer } from "bonang";
import { ProductRepository } from "./product-repository.bng";
import { ProductService } from "./product-service.bng";
import { ProductController } from "./product-controller.bng";

/**
 * Buat instance aplikasi lengkap: server + repository + service + controller.
 *
 * `options.databaseFile` menentukan file SQLite yang dipakai.
 * `options.port` 0 berarti port acak (dipakai test).
 */
export async fn createApp(options = {}) {
    const port = options.port !== undefined ? options.port : 3000;
    const host = options.host || "127.0.0.1";
    const databaseFile = options.databaseFile || "data/bonang_demo.db";

    // Folder statis dicari relatif terhadap direktori kerja saat dev
    // (`public/`) dan relatif terhadap folder build saat produksi
    // (`dist/public` dan `dist/client.js`). Beberapa kandidat dicoba agar
    // aplikasi tetap berjalan baik dari sumber maupun dari bundel.
    const staticDir = options.staticDir || ["public", "dist", "dist/public"];

    const app = createServer({
        port,
        host,
        staticDir,
        logger: options.logger || {
            info() {}, warn() {}, error() {}, debug() {}
        }
    });

    const repository = ProductRepository.createDefault(databaseFile);
    await repository.ensureSchema();

    const service = new ProductService(repository);
    const controller = new ProductController(service);
    controller.registerRoutes(app.router);

    // Informasi API. Path `/` sengaja dipakai untuk berkas statis
    // (`public/index.html`) agar frontend langsung termuat di browser.
    app.router.get("/api/info", () => ({
        name: "Bonang CRUD Demo",
        message: "Gunakan /api/products untuk API CRUD produk.",
        endpoints: [
            "GET /api/products",
            "GET /api/products/summary",
            "GET /api/products/:id",
            "POST /api/products",
            "PUT /api/products/:id",
            "DELETE /api/products/:id",
            "POST /api/sync"
        ]
    }));

    app.router.get("/api/health", () => ({
        status: "ok",
        uptime: process.uptime(),
        database: databaseFile
    }));

    // Simpan objek pendukung supaya pemanggil bisa menutup dengan benar.
    app.repository = repository;
    app.service = service;
    app.controller = controller;

    return app;
}

/**
 * Jalankan aplikasi dan dengarkan pada port yang diminta.
 */
export async fn startApp(options = {}) {
    const app = await createApp(options);
    await app.listen(options.port !== undefined ? options.port : 3000);
    return app;
}
