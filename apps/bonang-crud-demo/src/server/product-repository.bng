// Lapisan repository: satu-satunya tempat yang menyentuh database.
//
// Seluruh query memakai prepared statement dengan placeholder positional `?`.
// Nama tabel dan kolom tidak pernah digabungkan dari input user.

import { createPool } from "bonang";
import { normalizeProduct } from "../shared/product.bng";

export class ProductRepository {
    constructor(pool) {
        this.pool = pool;
        this.table = "products";
    }

    /**
     * Buat repository baru yang terhubung ke database demo.
     */
    static createDefault(databaseFile) {
        return new ProductRepository(createPool({ filename: databaseFile, max: 10 }));
    }

    /**
     * Buat tabel beserta indeks yang dibutuhkan.
     */
    async ensureSchema() {
        await this.pool.execute(`
            CREATE TABLE IF NOT EXISTS products (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL,
                description TEXT NOT NULL DEFAULT '',
                price REAL NOT NULL DEFAULT 0,
                stock INTEGER NOT NULL DEFAULT 0,
                created_at TEXT NOT NULL,
                updated_at TEXT NOT NULL
            )
        `);
        await this.pool.execute(
            "CREATE INDEX IF NOT EXISTS idx_products_name ON products (name)"
        );
        await this.pool.execute(
            "CREATE INDEX IF NOT EXISTS idx_products_updated_at ON products (updated_at)"
        );
    }

    /**
     * Ambil semua produk, dengan pencarian dan paginasi opsional.
     */
    async findAll(options = {}) {
        const filters = [];
        const params = [];

        if (options.search) {
            filters.push("(name LIKE ? OR description LIKE ?)");
            const pattern = `%${options.search}%`;
            params.push(pattern, pattern);
        }
        if (options.minPrice !== undefined && options.minPrice !== null) {
            filters.push("price >= ?");
            params.push(Number(options.minPrice));
        }
        if (options.maxPrice !== undefined && options.maxPrice !== null) {
            filters.push("price <= ?");
            params.push(Number(options.maxPrice));
        }

        const where = filters.length > 0 ? `WHERE ${filters.join(' AND ')}` : '';
        const limit = Math.min(Math.max(Number(options.limit) || 50, 1), 200);
        const offset = Math.max(Number(options.offset) || 0, 0);

        const rows = await this.pool.query(
            `SELECT * FROM ${this.table} ${where} ORDER BY id DESC LIMIT ? OFFSET ?`,
            [...params, limit, offset]
        );

        const total = await this.pool.queryOne(
            `SELECT COUNT(*) AS total FROM ${this.table} ${where}`,
            params
        );

        return {
            items: rows.map((row) => this.toProduct(row)),
            total: total ? total.total : 0,
            limit,
            offset
        };
    }

    /**
     * Ambil satu produk berdasarkan id.
     */
    async findById(id) {
        const row = await this.pool.queryOne(
            `SELECT * FROM ${this.table} WHERE id = ?`,
            [Number(id)]
        );
        return row ? this.toProduct(row) : null;
    }

    /**
     * Cari produk berdasarkan nama (case-insensitive, duikat diperbolehkan).
     */
    async findByName(name) {
        const rows = await this.pool.query(
            `SELECT * FROM ${this.table} WHERE name = ? ORDER BY id`,
            [String(name)]
        );
        return rows.map((row) => this.toProduct(row));
    }

    /**
     * Simpan produk baru.
     */
    async create(input) {
        const data = normalizeProduct(input);
        const now = new Date().toISOString();

        const result = await this.pool.execute(
            `INSERT INTO ${this.table} (name, description, price, stock, created_at, updated_at)
             VALUES (?, ?, ?, ?, ?, ?)`,
            [data.name, data.description, data.price, data.stock, now, now]
        );

        return this.findById(result.lastInsertRowid);
    }

    /**
     * Perbarui produk yang sudah ada.
     */
    async update(id, input) {
        const existing = await this.findById(id);
        if (!existing) return null;

        const data = normalizeProduct({
            name: input.name !== undefined ? input.name : existing.name,
            description: input.description !== undefined ? input.description : existing.description,
            price: input.price !== undefined ? input.price : existing.price,
            stock: input.stock !== undefined ? input.stock : existing.stock
        });

        await this.pool.execute(
            `UPDATE ${this.table}
             SET name = ?, description = ?, price = ?, stock = ?, updated_at = ?
             WHERE id = ?`,
            [data.name, data.description, data.price, data.stock, new Date().toISOString(), Number(id)]
        );

        return this.findById(id);
    }

    /**
     * Hapus produk.
     */
    async remove(id) {
        const result = await this.pool.execute(
            `DELETE FROM ${this.table} WHERE id = ?`,
            [Number(id)]
        );
        return result.changes > 0;
    }

    /**
     * Ringkasan untuk dashboard.
     */
    async summary() {
        const totals = await this.pool.queryOne(
            `SELECT COUNT(*) AS total, COALESCE(SUM(price * stock), 0) AS inventory_value,
                    COALESCE(SUM(stock), 0) AS total_stock
             FROM ${this.table}`
        );
        const lowStock = await this.pool.query(
            `SELECT * FROM ${this.table} WHERE stock < 10 ORDER BY stock ASC LIMIT 5`
        );
        return {
            total: totals ? totals.total : 0,
            totalStock: totals ? totals.total_stock : 0,
            inventoryValue: totals ? totals.inventory_value : 0,
            lowStock: lowStock.map((row) => this.toProduct(row))
        };
    }

    /**
     * Ubah baris database menjadi objek produk.
     */
    toProduct(row) {
        return {
            id: Number(row.id),
            name: row.name,
            description: row.description,
            price: Number(row.price),
            stock: Number(row.stock),
            createdAt: row.created_at,
            updatedAt: row.updated_at
        };
    }
}
